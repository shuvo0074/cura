// Cura — data model.
//
// Indexing strategy is driven by the read paths the specification demands:
// universal search (mobile/name/curaId), the calendar grid (doctor + time
// range), and the patient timeline (patient + occurredAt desc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRATOR
  DOCTOR
  DESK_STAFF
  /// A public directory account: no access to any clinic module.
  PUBLIC_USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  WAITING
  ENGAGED
  DONE
  CANCELLED
  NO_SHOW
}

enum VisitType {
  NEW
  FOLLOW_UP
  OLD
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  STAFF_DEVICE
  PATIENT_CONSENT
  DOCTOR_CLAIM
}

enum DocumentCategory {
  NID_FRONT
  NID_BACK
  MEDICAL_CERTIFICATE
  DIGITAL_SIGNATURE
  LAB_REPORT
  EXTERNAL_PRESCRIPTION
  OTHER
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  fullName       String    @db.VarChar(120)
  email          String?   @unique @db.VarChar(160)
  mobile         String?   @unique @db.VarChar(20)
  /// Null only for a doctor an admin added who has not created a login yet.
  passwordHash   String?   @db.VarChar(255)
  role           UserRole  @default(DOCTOR)
  bmdcNumber     String?   @unique @db.VarChar(20)
  gender         Gender?
  dateOfBirth    DateTime? @db.Date
  bloodGroup     String?   @db.VarChar(4)
  secondaryPhone String?   @db.VarChar(20)
  avatarUrl      String?   @db.VarChar(512)
  locale         String    @default("en") @db.VarChar(5)

  /// AES-256-GCM ciphertext. Never selected into list queries.
  nidEncrypted   Bytes?
  /// Deterministic HMAC of the NID, for duplicate detection without decrypting.
  nidFingerprint String? @unique @db.VarChar(64)

  emailVerifiedAt    DateTime?
  mobileVerifiedAt   DateTime?
  onboardingStep     Int       @default(0)
  onboardingComplete Boolean   @default(false)

  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// Bumped on password change / forced logout; invalidates every issued token.
  tokenVersion     Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships     PracticeMembership[]
  refreshTokens   RefreshToken[]
  qualifications  Qualification[]
  awards          Award[]
  documents       DocumentAsset[]
  appointments    Appointment[]        @relation("DoctorAppointments")
  encounters      Encounter[]
  auditLogs       AuditLog[]
  onboardingDraft OnboardingDraft?

  directoryRoles        UserDirectoryRole[]
  ownedAmbulances       AmbulanceVendor[]
  ownedPharmacies       Pharmacy[]
  ownedHospitals        Hospital[]
  patientAccount        PatientAccount?
  doctorListing         DoctorListing?
  doctorVerifications   DoctorVerification[] @relation("VerificationApplicant")
  reviewedVerifications DoctorVerification[] @relation("VerificationReviewer")

  @@index([isActive, role])
  @@index([deletedAt])
  @@map("users")
}

model Qualification {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  degreeName    String   @db.VarChar(120)
  instituteName String   @db.VarChar(160)
  passingYear   Int?
  country       String?  @db.VarChar(80)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("qualifications")
}

model Award {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String   @db.VarChar(160)
  year      Int?
  issuer    String?  @db.VarChar(160)
  country   String?  @db.VarChar(80)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("awards")
}

/// Server-side autosave for the 4-step wizard (spec 3.2.6(d) state persistence).
model OnboardingDraft {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  step      Int      @default(1)
  payload   Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_drafts")
}

model Practice {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @db.VarChar(160)
  specialization String? @db.VarChar(120)
  contactNumber  String? @db.VarChar(20)
  email          String? @db.VarChar(160)
  website        String? @db.VarChar(200)
  /// Business Identification Number — the Bangladeshi analogue of a GSTIN.
  binNumber      String? @db.VarChar(40)
  address        String? @db.VarChar(400)
  addressLine1   String? @db.VarChar(200)
  locality       String? @db.VarChar(120)
  city           String? @db.VarChar(80)
  country        String  @default("Bangladesh") @db.VarChar(80)
  postCode       String? @db.VarChar(12)
  mapsUrl        String? @db.VarChar(512)
  logoUrl        String? @db.VarChar(512)
  roomNumber     String? @db.VarChar(40)
  slotMinutes    Int     @default(10)
  timezone       String  @default("Asia/Dhaka") @db.VarChar(60)

  /// Calendar display default (spec 6.6.c.1.4.1) — on by default.
  showTodayFirst        Boolean @default(true)
  /// Outgoing SMS language (spec: Communications → Language Settings).
  smsLanguage           String  @default("en") @db.VarChar(5)
  /// Data-security preferences: keep voided documents out of listings.
  hideCancelledInvoices Boolean @default(false)
  hideCancelledPayments Boolean @default(false)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships   PracticeMembership[]
  sessions      PracticeSession[]
  closures      PracticeClosure[]
  appointments  Appointment[]
  patients      Patient[]
  emailSettings EmailSetting[]
  feedback      PatientFeedback[]

  @@index([isActive])
  @@map("practices")
}

model PracticeMembership {
  id         String   @id @default(uuid()) @db.Uuid
  practiceId String   @db.Uuid
  userId     String   @db.Uuid
  role       UserRole
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  /// Per-member notification matrix (spec: Practice Staff → Notifications).
  /// Daily schedule summary and real-time appointment confirmations, each
  /// deliverable over SMS, email, or both.
  notifyScheduleSms      Boolean @default(true)
  notifyScheduleEmail    Boolean @default(true)
  notifyAppointmentSms   Boolean @default(true)
  notifyAppointmentEmail Boolean @default(true)

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([practiceId, userId])
  @@index([userId, isActive])
  @@map("practice_memberships")
}

model PracticeSession {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid
  /// 0 = Sunday .. 6 = Saturday
  dayOfWeek  Int    @db.SmallInt
  startTime  String @db.VarChar(5)
  endTime    String @db.VarChar(5)

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([practiceId, dayOfWeek])
  @@map("practice_sessions")
}

/// Off-days and ad-hoc blocks (spec 6.6.c.1.4.4 + Block Calendar).
model PracticeClosure {
  id         String   @id @default(uuid()) @db.Uuid
  practiceId String   @db.Uuid
  startsAt   DateTime
  endsAt     DateTime
  allDay     Boolean  @default(true)
  reason     String?  @db.VarChar(240)
  createdAt  DateTime @default(now())

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([practiceId, startsAt, endsAt])
  @@map("practice_closures")
}

model Patient {
  id          String    @id @default(uuid()) @db.Uuid
  practiceId  String    @db.Uuid
  curaId      String    @unique @db.VarChar(20)
  fullName    String    @db.VarChar(120)
  mobile      String    @db.VarChar(20)
  email       String?   @db.VarChar(160)
  gender      Gender?
  dateOfBirth DateTime? @db.Date
  bloodGroup  String?   @db.VarChar(4)
  address     String?   @db.VarChar(400)
  avatarUrl   String?   @db.VarChar(512)
  occupation  String?   @db.VarChar(120)
  referredBy  String?   @db.VarChar(120)
  /// The patient's Cura Website account, when they joined this clinic there.
  accountId   String?   @db.Uuid

  /// Lower-cased, de-punctuated name used for prefix search.
  searchName String @db.VarChar(160)

  profileComplete Boolean   @default(false)
  lastVisitAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  practice     Practice          @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  account      PatientAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  encounters   Encounter[]
  consents     PatientConsent[]
  documents    DocumentAsset[]
  invoices     Invoice[]
  feedback     PatientFeedback[]

  /// One clinic record per website account; null for patients the clinic registered.
  @@unique([practiceId, accountId])
  /// Family members sharing one mobile number resolve through this index.
  @@index([practiceId, mobile])
  @@index([practiceId, searchName])
  @@index([practiceId, lastVisitAt(sort: Desc)])
  @@index([deletedAt])
  @@map("patients")
}

/// Consent unlocking history older than the 90-day privacy window.
model PatientConsent {
  id              String    @id @default(uuid()) @db.Uuid
  patientId       String    @db.Uuid
  grantedToUserId String    @db.Uuid
  grantedAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  method          String    @db.VarChar(20)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, grantedToUserId, expiresAt])
  @@map("patient_consents")
}

model Appointment {
  id         String @id @default(uuid()) @db.Uuid
  practiceId String @db.Uuid
  doctorId   String @db.Uuid
  patientId  String @db.Uuid

  scheduledAt       DateTime
  endsAt            DateTime
  durationMinutes   Int
  status            AppointmentStatus @default(SCHEDULED)
  visitType         VisitType         @default(NEW)
  tokenNumber       Int?
  plannedProcedures String[]
  notes             String?           @db.VarChar(1000)

  checkedInAt  DateTime?
  engagedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?   @db.VarChar(240)

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  practice       Practice       @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  doctor         User           @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter      Encounter?
  /// Set when a patient booked this visit on Cura Website.
  websiteBooking SerialBooking?

  /// Primary calendar read path: one doctor's grid over a time window.
  @@index([doctorId, scheduledAt])
  @@index([practiceId, scheduledAt])
  @@index([practiceId, status, scheduledAt])
  @@index([patientId, scheduledAt(sort: Desc)])
  @@map("appointments")
}

model Encounter {
  id            String    @id @default(uuid()) @db.Uuid
  patientId     String    @db.Uuid
  doctorId      String    @db.Uuid
  appointmentId String?   @unique @db.Uuid
  occurredAt    DateTime
  /// Once signed the clinical record is immutable; corrections are addenda.
  signedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       User            @relation(fields: [doctorId], references: [id])
  appointment  Appointment?    @relation(fields: [appointmentId], references: [id])
  vitals       Vitals?
  clinicalNote ClinicalNote?
  prescription Prescription?
  documents    DocumentAsset[]

  /// Timeline read path.
  @@index([patientId, occurredAt(sort: Desc)])
  @@index([doctorId, occurredAt(sort: Desc)])
  @@map("encounters")
}

model Vitals {
  id              String   @id @default(uuid()) @db.Uuid
  encounterId     String   @unique @db.Uuid
  weightKg        Decimal? @db.Decimal(5, 2)
  systolic        Int?
  diastolic       Int?
  pulseBpm        Int?
  temperatureC    Decimal? @db.Decimal(4, 1)
  respiratoryRate Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("vitals")
}

model ClinicalNote {
  id           String   @id @default(uuid()) @db.Uuid
  encounterId  String   @unique @db.Uuid
  complaints   String[]
  observations String[]
  diagnoses    String[]
  advice       String[]
  notes        String?  @db.VarChar(4000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("clinical_notes")
}

model Prescription {
  id             String    @id @default(uuid()) @db.Uuid
  encounterId    String    @unique @db.Uuid
  investigations String[]
  followUpDate   DateTime? @db.Date
  signedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  encounter      Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  items          PrescriptionItem[]
  pharmacyOrders PharmacyOrder[]

  /// Communications' follow-up list reads by due date.
  @@index([followUpDate])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid()) @db.Uuid
  prescriptionId String  @db.Uuid
  position       Int
  drugName       String  @db.VarChar(160)
  strength       String? @db.VarChar(40)
  form           String? @db.VarChar(40)
  durationDays   Int?
  morning        Decimal @default(0) @db.Decimal(4, 2)
  noon           Decimal @default(0) @db.Decimal(4, 2)
  night          Decimal @default(0) @db.Decimal(4, 2)
  mealRelation   String  @default("ANY") @db.VarChar(10)
  instruction    String? @db.VarChar(300)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, position])
  @@map("prescription_items")
}

model DocumentAsset {
  id          String           @id @default(uuid()) @db.Uuid
  ownerUserId String?          @db.Uuid
  patientId   String?          @db.Uuid
  encounterId String?          @db.Uuid
  category    DocumentCategory
  fileName    String           @db.VarChar(255)
  mimeType    String           @db.VarChar(100)
  sizeBytes   Int
  storageKey  String           @db.VarChar(512)
  /// SHA-256 of the bytes; de-duplicates uploads and detects tampering.
  checksum    String           @db.VarChar(64)
  capturedOn  DateTime?        @db.Date
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?

  owner     User?      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  patient   Patient?   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([patientId, category])
  @@index([encounterId])
  @@map("document_assets")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  /// SHA-256 of the token. The raw value never touches the database.
  tokenHash    String    @unique @db.VarChar(64)
  /// Rotation lineage — reuse of a rotated token revokes the whole family.
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?   @db.VarChar(300)
  ipHash       String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  purpose     OtpPurpose
  /// Hash of purpose+destination+code+pepper. Codes are never stored in clear.
  codeHash    String     @db.VarChar(64)
  destination String     @db.VarChar(160)
  subjectId   String?    @db.Uuid
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([destination, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// Append-only PHI access trail.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String   @db.VarChar(80)
  resourceType String   @db.VarChar(60)
  resourceId   String?  @db.VarChar(64)
  practiceId   String?  @db.Uuid
  ipHash       String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(300)
  requestId    String?  @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([createdAt(sort: Desc)])
  /// A clinic owner's activity log: one clinic, newest first.
  @@index([practiceId, createdAt(sort: Desc)])
  /// Activity log filtered by action.
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Drug {
  id          String    @id @default(uuid()) @db.Uuid
  practiceId  String?   @db.Uuid
  name        String    @db.VarChar(160)
  form        String?   @db.VarChar(40)
  strength    String?   @db.VarChar(40)
  unit        String?   @db.VarChar(20)
  instruction String?   @db.VarChar(300)
  searchName  String    @db.VarChar(160)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([practiceId, searchName])
  @@map("drugs")
}

model CatalogEntry {
  id          String    @id @default(uuid()) @db.Uuid
  practiceId  String    @db.Uuid
  /// COMPLAINT | OBSERVATION | DIAGNOSIS | ADVICE | NOTE
  kind        String    @db.VarChar(20)
  value       String    @db.VarChar(300)
  searchValue String    @db.VarChar(300)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@unique([practiceId, kind, value])
  @@index([practiceId, kind, searchValue])
  @@map("catalog_entries")
}

model PricingItem {
  id         String    @id @default(uuid()) @db.Uuid
  practiceId String    @db.Uuid
  name       String    @db.VarChar(160)
  priceMinor Int
  notes      String?   @db.VarChar(400)
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@unique([practiceId, name])
  @@map("pricing_items")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  BANK_TRANSFER
  OTHER
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  practiceId    String        @db.Uuid
  patientId     String        @db.Uuid
  encounterId   String?       @db.Uuid
  /// Human-facing sequential number, unique per practice.
  number        String        @db.VarChar(30)
  status        InvoiceStatus @default(DRAFT)
  /// Money is stored in minor units (poisha) as integers. Floating point is
  /// never used for currency.
  subtotalMinor Int           @default(0)
  discountMinor Int           @default(0)
  taxMinor      Int           @default(0)
  totalMinor    Int           @default(0)
  paidMinor     Int           @default(0)
  notes         String?       @db.VarChar(600)
  issuedAt      DateTime?
  createdById   String?       @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([practiceId, number])
  @@index([practiceId, status, createdAt(sort: Desc)])
  @@index([patientId, createdAt(sort: Desc)])
  @@map("invoices")
}

model InvoiceItem {
  id            String  @id @default(uuid()) @db.Uuid
  invoiceId     String  @db.Uuid
  pricingItemId String? @db.Uuid
  description   String  @db.VarChar(200)
  quantity      Int     @default(1)
  unitMinor     Int
  discountMinor Int     @default(0)
  totalMinor    Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @db.Uuid
  amountMinor  Int
  method       PaymentMethod @default(CASH)
  reference    String?       @db.VarChar(120)
  receivedById String?       @db.Uuid
  receivedAt   DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

/// Per-practice notification matrix (spec: Communications category/type table).
model CommunicationSetting {
  id           String   @id @default(uuid()) @db.Uuid
  practiceId   String   @db.Uuid
  /// APPOINTMENT | FOLLOW_UP | PAYMENT | WISHES
  category     String   @db.VarChar(30)
  /// CONFIRMATION | CANCELLATION | REMINDER | INVOICE | BIRTHDAY | ANNIVERSARY
  type         String   @db.VarChar(30)
  smsEnabled   Boolean  @default(false)
  emailEnabled Boolean  @default(false)
  /// Offset in days for scheduled messages (e.g. 180 for the 6-month recall).
  offsetDays   Int?
  updatedAt    DateTime @updatedAt

  @@unique([practiceId, category, type])
  @@map("communication_settings")
}

/// Printout / page-setup configuration (spec: Printouts page setup + layout).
model PrintoutSetting {
  id             String   @id @default(uuid()) @db.Uuid
  practiceId     String   @db.Uuid
  /// EMR | BILLING
  documentType   String   @db.VarChar(20)
  printerType    String   @default("COLOUR") @db.VarChar(20)
  paperSize      String   @default("A4") @db.VarChar(10)
  orientation    String   @default("PORTRAIT") @db.VarChar(12)
  marginTopMm    Int      @default(50)
  marginBottomMm Int      @default(12)
  marginLeftMm   Int      @default(6)
  marginRightMm  Int      @default(6)
  fontScale      Int      @default(100)
  showHeader     Boolean  @default(true)
  showFooter     Boolean  @default(true)
  headerHtml     String?  @db.VarChar(2000)
  footerHtml     String?  @db.VarChar(2000)
  /// Scanned prescription pad used as a background image.
  padImageKey    String?  @db.VarChar(512)
  /// Ordered list of section keys (vitals, diagnosis, advice, ...).
  sectionOrder   String[]
  updatedAt      DateTime @updatedAt

  @@unique([practiceId, documentType])
  @@map("printout_settings")
}

/// Header and footer blocks for outgoing patient emails (spec: Settings →
/// Email). Kept apart from PrintoutSetting because an email header is three
/// independent text blocks rendered by an HTML mailer, not a page layout.
model EmailSetting {
  id          String   @id @default(uuid()) @db.Uuid
  practiceId  String   @db.Uuid
  /// HEADER | FOOTER
  section     String   @db.VarChar(10)
  title       String?  @db.VarChar(160)
  leftText    String?  @db.VarChar(1000)
  rightText   String?  @db.VarChar(1000)
  includeLogo Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@unique([practiceId, section])
  @@map("email_settings")
}

model ConsentFormTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  practiceId String   @db.Uuid
  title      String   @db.VarChar(160)
  bodyHtml   String   @db.Text
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([practiceId, isActive])
  @@map("consent_form_templates")
}

model ChartingTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  practiceId   String   @db.Uuid
  name         String   @db.VarChar(160)
  diagnoses    String[]
  labOrders    String[]
  followUpDays Int?
  createdAt    DateTime @default(now())

  @@unique([practiceId, name])
  @@map("charting_templates")
}

model Subscription {
  id         String    @id @default(uuid()) @db.Uuid
  practiceId String    @unique @db.Uuid
  /// FREE | PREMIUM
  plan       String    @default("FREE") @db.VarChar(20)
  status     String    @default("ACTIVE") @db.VarChar(20)
  startedAt  DateTime  @default(now())
  expiresAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

/// A patient's rating of a visit (spec: Feedback Management). Recorded by the
/// practice on the patient's behalf; the reply is the practice's response.
model PatientFeedback {
  id            String    @id @default(uuid()) @db.Uuid
  practiceId    String    @db.Uuid
  patientId     String    @db.Uuid
  appointmentId String?   @db.Uuid
  /// 1–5 stars.
  rating        Int       @db.SmallInt
  comment       String?   @db.VarChar(1000)
  reply         String?   @db.VarChar(1000)
  repliedAt     DateTime?
  repliedById   String?   @db.Uuid
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([practiceId, createdAt(sort: Desc)])
  @@map("patient_feedback")
}

// ---------------------------------------------------------------------------
// Public directory (merged from the Cura Health directory app)
//
// Deliberately separate from the clinical models above. A listing is public
// marketing data; `Patient` and `Appointment` are private clinical records, and
// nothing here reads or writes them.
// ---------------------------------------------------------------------------

/// Roles on the public directory. Kept apart from `User.role`, which is the
/// clinic access level: a clinic administrator is not a directory admin.
/// A person can hold several of these. Clinic access levels stay on the
/// practice membership, because they apply per clinic.
enum DirectoryRole {
  SUPER_ADMIN
  PATIENT
  DOCTOR
  AMBULANCE_OWNER
  PHARMACY_OWNER
  HOSPITAL_OWNER
}

enum VerificationKind {
  CLAIM
  NEW
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileItemKind {
  POSITION
  QUALIFICATION
  PUBLICATION
  MEMBERSHIP
  AWARD
}

enum SerialBookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

model UserDirectoryRole {
  userId    String        @db.Uuid
  role      DirectoryRole
  grantedAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_directory_roles")
}

/// A patient's Cura Website account. Linked to a clinic's `Patient` record only
/// for clinics the patient chose to join.
model PatientAccount {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  name      String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings          SerialBooking[]
  reviews           DoctorReview[]
  clinicRecords     Patient[]
  pharmacyOrders    PharmacyOrder[]
  ambulanceRequests AmbulanceRequest[]

  @@map("patient_accounts")
}

model Hospital {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  location       String
  division       String?
  address        String?
  hotline        String?
  photo          String?
  lat            Float?
  lng            Float?
  website        String?
  doctorCount    Int       @default(0)
  description    String?
  type           String?
  services       Json?
  beds           Json?
  tests          Json?
  facilities     Json?
  paymentMethods Json?
  openingHours   String?
  visitingHours  String?
  sourceUrl      String?
  verifiedOn     DateTime? @db.Date
  hidden         Boolean   @default(false)
  /// The account allowed to edit this place's public details, linked by a super admin.
  ownerId        String?   @db.Uuid
  createdAt      DateTime  @default(now())

  owner   User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  doctors DoctorListing[]

  @@index([hidden, type])
  @@index([ownerId])
  @@map("hospitals")
}

model DoctorListing {
  id                String    @id @default(uuid()) @db.Uuid
  /// Every doctor is a user. Whether they can log in depends on `User.passwordHash`.
  userId            String    @unique @db.Uuid
  name              String
  specialty         String
  department        String?
  experience        String?
  chamber           String?
  workplace         String?
  fees              Int?
  followupFees      Int?      @default(300)
  city              String?
  division          String?
  hospitalId        String?   @db.Uuid
  phone             String?
  photo             String?
  rating            Float?
  about             String?
  lat               Float?
  lng               Float?
  website           String?
  gender            String?   @db.VarChar(10)
  genderIsDemo      Boolean   @default(false)
  /// Normalised (A-12345). Unique, so two approvals cannot create duplicates.
  bmdcNo            String?   @unique
  /// The verified badge. Distinct from `verifiedOn`, the source check date.
  bmdcVerifiedAt    DateTime?
  education         String?
  languages         String?
  consultingHours   String?
  address           String?
  clinicalExpertise String[]
  treatments        String[]
  weeklySchedule    Json?
  headline          String?
  slug              String?   @unique
  practicingSince   Int?      @db.SmallInt
  profileUpdatedAt  DateTime?
  shareCount        Int       @default(0)
  sourceUrl         String?
  verifiedOn        DateTime? @db.Date
  hidden            Boolean   @default(false)
  /// A doctor who signed up, waiting for an admin. Also `hidden` while true.
  pendingApproval   Boolean   @default(false)
  createdAt         DateTime  @default(now())

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital      Hospital?            @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  verifications DoctorVerification[]
  items         DoctorProfileItem[]
  endorsements  DoctorEndorsement[]  @relation("EndorsedDoctor")
  endorsed      DoctorEndorsement[]  @relation("EndorserDoctor")
  bookings      SerialBooking[]
  reviews       DoctorReview[]
  callLogs      CallLog[]
  dailyStats    DoctorDailyStat[]

  @@index([hidden, specialty])
  @@index([hidden, division])
  @@index([hospitalId])
  @@map("doctors")
}

/// A pharmacy, managed by its owner on Cura Dashboard.
model Pharmacy {
  id            String   @id @default(uuid()) @db.Uuid
  ownerId       String   @db.Uuid
  name          String
  licenseNumber String?
  address       String?
  city          String?
  phones        Json     @default("[]")
  openingHours  String?
  homeDelivery  Boolean  @default(false)
  /// Hidden from patients. A pharmacy an owner adds waits here for a super admin.
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner  User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stock  PharmacyStockItem[]
  orders PharmacyOrder[]

  @@index([ownerId])
  @@map("pharmacies")
}

/// A medicine a pharmacy lists. Patients see the in-stock ones on Cura Website.
model PharmacyStockItem {
  id         String   @id @default(uuid()) @db.Uuid
  pharmacyId String   @db.Uuid
  name       String   @db.VarChar(160)
  strength   String?  @db.VarChar(40)
  form       String?  @db.VarChar(40)
  /// Poisha, like invoices. Null when the owner gives no price.
  priceMinor Int?
  inStock    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, name])
  @@map("pharmacy_stock_items")
}

enum PharmacyOrderStatus {
  NEW
  READY
  COLLECTED
  CANNOT_FILL
  CANCELLED
}

/// A patient sends one of their prescriptions to a pharmacy to collect it there.
/// The pharmacy reads only the copy kept here: who sent it and the prescribed
/// medicines, never the visit or any other record.
model PharmacyOrder {
  id             String              @id @default(uuid()) @db.Uuid
  pharmacyId     String              @db.Uuid
  /// The sender's Cura Website account (`patient_accounts`).
  accountId      String              @db.Uuid
  prescriptionId String?             @db.Uuid
  status         PharmacyOrderStatus @default(NEW)
  patientName    String              @db.VarChar(120)
  patientPhone   String?             @db.VarChar(20)
  doctorName     String              @db.VarChar(120)
  prescribedAt   DateTime
  /// The prescribed medicines as they were when sent.
  items          Json
  note           String?             @db.VarChar(500)
  /// Why the pharmacy cannot fill it, when it says.
  reason         String?             @db.VarChar(300)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  pharmacy     Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  account      PatientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  prescription Prescription?  @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  @@index([pharmacyId, createdAt])
  @@index([accountId, createdAt])
  @@index([prescriptionId])
  @@map("pharmacy_orders")
}

model AmbulanceVendor {
  id              String    @id @default(uuid()) @db.Uuid
  /// The account allowed to edit this vendor, assigned by a super admin.
  ownerId         String?   @db.Uuid
  slug            String    @unique
  name            String
  nameBn          String?
  baseArea        String?
  address         String?
  addressBn       String?
  phones          Json      @default("[]")
  categories      Json      @default("[]")
  features        Json      @default("[]")
  dhakaWide       Boolean   @default(false)
  serviceAreas    Json      @default("[]")
  fares           Json      @default("{}")
  sourceUrl       String?
  sourceCheckedOn DateTime? @db.Date
  hidden          Boolean   @default(false)

  owner    User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  requests AmbulanceRequest[]

  @@map("ambulance_vendors")
}

enum AmbulanceRequestStatus {
  NEW
  ACCEPTED
  COMPLETED
  DECLINED
  CANCELLED
}

/// A patient asks an ambulance service with an owner to come, through Cura Website.
/// The owner reads only what the patient typed here, never any clinic record.
model AmbulanceRequest {
  id            String                 @id @default(uuid()) @db.Uuid
  vendorId      String                 @db.Uuid
  /// The requester's Cura Website account (`patient_accounts`).
  accountId     String                 @db.Uuid
  status        AmbulanceRequestStatus @default(NEW)
  patientName   String                 @db.VarChar(120)
  /// The number the ambulance should call, as `+8801…`.
  contactPhone  String                 @db.VarChar(20)
  pickupAddress String                 @db.VarChar(300)
  destination   String?                @db.VarChar(200)
  note          String?                @db.VarChar(500)
  /// When the patient wants the ambulance. Null means as soon as possible.
  pickupAt      DateTime?
  /// The owner's message to the patient: an arrival time when accepting, or why they declined.
  ownerMessage  String?                @db.VarChar(300)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  vendor  AmbulanceVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  account PatientAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
  @@index([accountId, createdAt])
  @@map("ambulance_requests")
}

model Specialty {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String  @unique
  nameBn      String?
  icon        String?
  description String?
  tags        Json    @default("[]")
  image       String?
  hidden      Boolean @default(false)

  @@map("specialties")
}

model Symptom {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String  @unique
  nameBn      String?
  description String?
  tags        Json    @default("[]")
  image       String?
  /// Specialty names.
  specialties Json    @default("[]")
  hidden      Boolean @default(false)

  @@map("symptoms")
}

/// Site-wide values admins edit. Per-practice settings live elsewhere.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model DoctorVerification {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  doctorId    String?            @db.Uuid
  kind        VerificationKind
  bmdcNo      String
  details     Json               @default("{}")
  status      VerificationStatus @default(PENDING)
  reviewNote  String?
  submittedAt DateTime           @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?            @db.Uuid

  user     User           @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  doctor   DoctorListing? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  reviewer User?          @relation("VerificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([doctorId, status])
  @@map("doctor_verifications")
}

model DoctorProfileItem {
  id           String          @id @default(uuid()) @db.Uuid
  doctorId     String          @db.Uuid
  kind         ProfileItemKind
  title        String
  organization String?
  location     String?
  startYear    Int?            @db.SmallInt
  endYear      Int?            @db.SmallInt
  isCurrent    Boolean         @default(false)
  url          String?
  description  String?
  createdAt    DateTime        @default(now())

  doctor DoctorListing @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, kind])
  @@map("doctor_profile_items")
}

model DoctorEndorsement {
  doctorId         String   @db.Uuid
  endorserDoctorId String   @db.Uuid
  skill            String
  createdAt        DateTime @default(now())

  doctor   DoctorListing @relation("EndorsedDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  endorser DoctorListing @relation("EndorserDoctor", fields: [endorserDoctorId], references: [id], onDelete: Cascade)

  @@id([doctorId, endorserDoctorId, skill])
  @@map("doctor_endorsements")
}

/// A numbered place in one chamber session. Serials are never reused, and two
/// partial unique indexes in the migration back that up.
model SerialBooking {
  id            String              @id @default(uuid()) @db.Uuid
  patientId     String              @db.Uuid
  doctorId      String              @db.Uuid
  bookingDate   DateTime            @db.Date
  /// Session start, HH:MM, Asia/Dhaka.
  startTime     String              @db.VarChar(5)
  status        SerialBookingStatus @default(CONFIRMED)
  notes         String?
  venue         String
  sessionTime   String
  serialNo      Int
  /// The clinic's appointment, when the booked venue is a clinic on Cura.
  appointmentId String?             @unique @db.Uuid
  createdAt     DateTime            @default(now())

  patient     PatientAccount @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      DoctorListing  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  review      DoctorReview?

  @@index([patientId, bookingDate(sort: Desc)])
  @@index([doctorId, bookingDate(sort: Desc)])
  @@map("serial_bookings")
}

model DoctorReview {
  id        String    @id @default(uuid()) @db.Uuid
  bookingId String    @unique @db.Uuid
  doctorId  String    @db.Uuid
  patientId String    @db.Uuid
  rating    Int       @db.SmallInt
  comment   String?
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  booking SerialBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  doctor  DoctorListing  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient PatientAccount @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId, createdAt(sort: Desc)])
  @@map("doctor_reviews")
}

/// Records the tap on a call button, not a connected call.
model CallLog {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @db.Uuid
  venue     String?
  phone     String?
  createdAt DateTime @default(now())

  doctor DoctorListing @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, createdAt])
  @@map("call_logs")
}

model DoctorDailyStat {
  doctorId String   @db.Uuid
  /// A Bangladesh calendar day.
  day      DateTime @db.Date
  views    Int      @default(0)
  shares   Int      @default(0)

  doctor DoctorListing @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([doctorId, day])
  @@map("doctor_daily_stats")
}
